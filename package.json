{
  "name": "@rpgengine/weather",
  "version": "0.3.1",
  "description": "Weather by the climate score for RPG Engine: each dawn the sky changes by a roll, with seasons, deserts, polar cold and fog.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "instructions",
    "extension.yaml",
    "words",
    "LICENSE.md",
    "README.md"
  ],
  "keywords": [
    "rpg-engine-package",
    "rpg-engine",
    "weather",
    "ttrpg"
  ],
  "author": "Stefano Caronia",
  "license": "(MIT AND CC-BY-4.0)",
  "homepage": "https://github.com/stefanocaronia/rpg-engine-weather#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanocaronia/rpg-engine-weather.git"
  },
  "bugs": {
    "url": "https://github.com/stefanocaronia/rpg-engine-weather/issues"
  },
  "rpg-engine": {
    "kind": "extension",
    "api": 4,
    "page": "dist/page.js"
  },
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . && dprint check && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "format": "eslint --fix . && dprint fmt"
  },
  "devDependencies": {
    "@rpgengine/system-5e": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "^8.72.1",
    "dprint": "^0.58.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "preact": "^10.29.8",
    "rpg-engine": "^0.8.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
